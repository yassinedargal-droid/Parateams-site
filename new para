            document.getElementById('bulkStagingTotalCount').textContent = bulkStagedProducts.length;
            document.getElementById('bulkStagingSelectedCount').textContent = bulkStagedProducts.filter(p => p.selected).length;

            tbody.innerHTML = bulkStagedProducts.slice(0, 200).map((item, idx) => `
                <tr class="hover:bg-sage-50/40">
                    <td class="p-2.5">
                        <input type="checkbox" ${item.selected ? 'checked' : ''} onchange="bulkStagedProducts[${idx}].selected = this.checked; updateBulkStagingCounts();" class="accent-sage-700">
