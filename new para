        }

        function handleHeroSlideAction(actionType) {
            if (actionType === 'new') triggerSlideNewArrivalsAction();
            else if (actionType === 'diagnostic') openDiagnosticModal();
            else if (actionType === 'giveaway') openGiveawayModal();
            else if (actionType === 'whatsapp') toggleWhatsAppPopup(true);
            else triggerSlidePromoAction();
        }

        function renderHeroSlides() {
            const track = document.getElementById('heroSlidesTrack');
            const dotsContainer = document.getElementById('heroDotsContainer');
            if (!track || !dotsContainer) return;

            const slides = SITE_DATA.slides;
            if (currentHeroSlide >= slides.length) currentHeroSlide = 0;

            track.innerHTML = slides.map((slide, idx) => {
                const isActive = idx === currentHeroSlide;
                const HeadingTag = idx === 0 ? 'h1' : 'h2';
                const action = escapeHtmlAttr(slide.actionType || 'promo');
                return `
                <div class="hero-slide absolute inset-0 transition-opacity duration-500 ease-in-out ${isActive ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0'} flex items-center" data-index="${idx}">
