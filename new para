        function normalizeCategoryName(cat) {
            if (!cat) return "Visage";
            const c = String(cat).trim();
            if (c === "Cheveux & Hygiène") return "Cheveux";
            if (c === "Bébés & Maman") return "Bébé & Maman";
            if (c === "Corps") return "Corps & Hygiène";
            const exists = STANDARD_PARATEAMS_RAYONS.some(r => !r.isBudget && r.name === c);
            return exists ? c : autoDetectProductRayon(c);
        }

        // GESTION INTELLIGENTE DU STOCK (QUANTITÉ EXACTE)
        function getProductStockQty(p) {
            if (typeof p.stockQty === 'number' && !isNaN(p.stockQty)) {
                return Math.max(0, Math.floor(p.stockQty));
            }
            if (p.stockStatus === 'out') return 0;
            if (p.stockStatus === 'low') return 2;
            return 10;
        }

        function syncProductStockFields(p, qty) {
            const cleanQty = Math.max(0, Math.floor(Number(qty) || 0));
            p.stockQty = cleanQty;
            p.stockStatus = cleanQty === 0 ? 'out' : (cleanQty <= 3 ? 'low' : 'good');
            return p;
        }

