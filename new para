        function parseProductsFromHtmlOrJson(rawContent) {
            const extracted = [];
            const seenNames = new Set();
            const defaultStock = getDefaultInitialStock();

            function pushUnique(item) {
                if (!item || !item.name) return;
                const cleanName = String(item.name).replace(/\s+/g, ' ').trim();
                const numPrice = parsePriceNumber(item.price);
                if (cleanName.length < 3 || numPrice <= 0) return;
                const key = cleanName.toLowerCase();
                if (seenNames.has(key)) return;
                seenNames.add(key);

                const numOld = parsePriceNumber(item.oldPrice);
                const validOld = numOld > numPrice ? numOld : null;
                const cleanBrand = String(item.brand || cleanName.split(' ')[0] || 'Parateams').trim();

                extracted.push({
                    selected: true,
                    brand: cleanBrand,
                    name: cleanName,
                    price: numPrice,
                    oldPrice: validOld,
                    category: getValidRayonName(item.category, { name: cleanName, brand: cleanBrand, description: item.description }),
                    imageUrl: String(item.imageUrl || item.image || '').trim(),
                    stockQty: typeof item.stockQty === 'number' ? item.stockQty : defaultStock,
                    badge: validOld ? `-${Math.round((1 - numPrice / validOld) * 100)}%` : "",
                    description: String(item.description || `${cleanBrand} — ${cleanName}`).trim()
                });
            }

            const trimmed = (rawContent || '').trim();
            if (!trimmed) return extracted;

            if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
                try {
                    const json = JSON.parse(trimmed);
                    const arr = Array.isArray(json) ? json : (json.products || json.items || [json]);
                    arr.forEach(obj => {
                        if (!obj) return;
                        if (obj.variants && Array.isArray(obj.variants) && obj.variants[0]) {
                            const v = obj.variants[0];
                            const img = (obj.images && obj.images[0] && obj.images[0].src) || (obj.image && obj.image.src) || '';
                            pushUnique({
                                brand: obj.vendor || "Parateams",
                                name: obj.title,
                                price: v.price,
                                oldPrice: v.compare_at_price,
                                category: obj.product_type,
                                imageUrl: img,
                                stockQty: obj.stockQty,
                                description: (obj.body_html || '').replace(/<[^>]*>/g, ' ').slice(0, 220)
                            });
                        } else if (obj.name || obj.title) {
                            pushUnique({
                                brand: obj.brand && typeof obj.brand === 'object' ? obj.brand.name : (obj.brand || obj.vendor),
                                name: obj.name || obj.title,
                                price: obj.price || (obj.offers && obj.offers.price),
                                oldPrice: obj.oldPrice || obj.compare_at_price,
                                category: obj.category,
                                imageUrl: Array.isArray(obj.image) ? obj.image[0] : (obj.imageUrl || obj.image),
                                stockQty: obj.stockQty,
                                description: obj.description
                            });
                        }
                    });
                    if (extracted.length > 0) return extracted;
                } catch (e) {}
            }

            const parser = new DOMParser();
            const doc = parser.parseFromString(trimmed, 'text/html');

            function normalizePalmarosaImg(rawSrc) {
                if (!rawSrc) return '';
                let s = rawSrc.trim();
                if (s.startsWith('data:image')) return '';
                if (s.startsWith('//')) return 'https:' + s;
                if (s.startsWith('/')) return 'https://www.palmarosashop.com' + s;
                return s;
            }

            // 1. Détection universelle par carte image + prix MAD/DH (spécial Palmarosa Shop Tailwind & Parapharma)
            doc.querySelectorAll('img').forEach(imgEl => {
                const rawSrc = imgEl.getAttribute('data-src') || imgEl.getAttribute('data-lazy-src') || imgEl.getAttribute('src') || '';
                if (/logo|icon|avatar|banner|flag|payment/i.test(rawSrc)) return;

                let card = imgEl.parentElement;
                let foundCard = null;
                for (let depth = 0; depth < 5 && card && card.tagName !== 'BODY'; depth++) {
                    const cardText = (card.innerText || card.textContent || '').trim();
                    const hasPrice = /(\d+(?:[\s.,]\d+)?)\s*(?:MAD|DH|Dhs)\b/i.test(cardText);
                    const imgsInCard = card.querySelectorAll('img').length;
                    if (hasPrice && imgsInCard <= 3) {
                        foundCard = card;
                        break;
                    }
                    card = card.parentElement;
                }

                if (!foundCard) return;
                const text = (foundCard.innerText || foundCard.textContent || '').trim();
                const priceMatches = [...text.matchAll(/(\d+(?:[\s.,]\d+)?)\s*(?:MAD|DH|Dhs)\b/gi)]
                    .map(m => parseFloat(m[1].replace(/\s/g, '').replace(',', '.')))
                    .filter(n => !isNaN(n) && n > 5 && n < 15000);
                if (priceMatches.length === 0) return;

                const cleanLines = text.split(/\r?\n/)
                    .map(l => l.replace(/\s+/g, ' ').trim())
                    .filter(l => l.length > 1 && !/^(rupture de stock|épuisé|epuise|ajouter au panier|ajouter|aperçu|favoris|\d+(?:[.,]\d+)?\s*(?:mad|dh|dhs)|★+|\d+[.,]\d+\s*\(\d+\))$/i.test(l));

                let brand = '';
                let name = '';
                if (cleanLines.length >= 2 && cleanLines[0].length <= 28 && cleanLines[1].length > cleanLines[0].length) {
                    brand = cleanLines[0];
                    name = cleanLines[1];
                } else if (cleanLines.length >= 1) {
                    name = cleanLines.find(l => l.length > 6) || cleanLines[0];
                    brand = name.includes('–') ? name.split('–')[0].trim() : (name.includes('-') ? name.split('-')[0].trim() : name.split(' ')[0]);
                }

                const price = Math.min(...priceMatches);
                const maxPrice = Math.max(...priceMatches);
                const oldPrice = maxPrice > price ? maxPrice : null;

                if (name && name.length > 3 && price > 0) {
                    pushUnique({
                        brand,
                        name,
                        price,
                        oldPrice,
                        imageUrl: normalizePalmarosaImg(rawSrc)
                    });
                }
            });

            // 2. Détection par sélecteurs e-commerce classiques
            const cardSelectors = 'article, .product, .product-card, .product-item, .grid-product, .product-miniature, .js-product-miniature, .item-product, li.product, [data-product-id], [class*="product-card"], [class*="product-item"], [class*="product"]';
            doc.querySelectorAll(cardSelectors).forEach(card => {
                const text = (card.innerText || card.textContent || '').trim();
                const priceMatches = [...text.matchAll(/(\d+(?:[\s.,]\d+)?)\s*(?:MAD|DH|Dhs|د\.م\.)/gi)]
                    .map(m => parseFloat(m[1].replace(/\s/g, '').replace(',', '.')))
                    .filter(n => !isNaN(n) && n > 5 && n < 15000);

                if (priceMatches.length === 0) return;

                const titleEl = card.querySelector('h2, h3, h4, .product-title, .card__heading, .product-card__title, .product-name, a[title], [class*="title"], [class*="name"]');
                const imgEl = card.querySelector('img');
                const brandEl = card.querySelector('.brand, .product-brand, .vendor, .manufacturer, [class*="brand"], [class*="vendor"], [class*="marque"]');

                let name = titleEl ? (titleEl.textContent || titleEl.getAttribute('title') || '').trim() : '';
                if (!name || name.length < 4) {
                    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 4 && !/rupture|epuise|épuisé|ajouter|panier|mad|dh/i.test(l));
                    name = lines[1] || lines[0] || '';
                }

                const price = Math.min(...priceMatches);
                const maxPrice = Math.max(...priceMatches);
                const oldPrice = maxPrice > price ? maxPrice : null;
                const img = imgEl ? normalizePalmarosaImg(imgEl.getAttribute('data-src') || imgEl.getAttribute('data-lazy-src') || imgEl.getAttribute('src') || '') : '';
                let brand = brandEl ? brandEl.textContent.trim() : '';
                if (!brand) {
                    brand = name.includes('–') ? name.split('–')[0].trim() : (name.includes('-') ? name.split('-')[0].trim() : name.split(' ')[0]);
                }

                if (name.length > 3 && price > 0) {
                    pushUnique({ brand, name, price, oldPrice, imageUrl: img });
                }
            });

            // 3. Analyse ligne par ligne du texte visible (quand on fait Ctrl+A puis Ctrl+C sur Palmarosa Shop)
            const plainTextBody = (doc.body ? (doc.body.innerText || doc.body.textContent || '') : '') + '\n' + trimmed.replace(/<[^>]+>/g, '\n');
            const lines = plainTextBody.split(/\r?\n/).map(l => l.replace(/\s+/g, ' ').trim()).filter(Boolean);
            for (let i = 0; i < lines.length; i++) {
                const priceMatch = lines[i].match(/(\d+(?:[.,]\d+)?)\s*(?:MAD|DH|Dhs)\b/i);
                if (priceMatch && i >= 1) {
                    const price = parseFloat(priceMatch[1].replace(',', '.'));
                    if (isNaN(price) || price <= 5) continue;
                    let nameLine = '';
                    let brandLine = '';
                    for (let j = i - 1; j >= Math.max(0, i - 6); j--) {
                        const candidate = lines[j];
                        if (candidate.length < 2) continue;
                        if (/^[\d.,\s★☆()/]+$/.test(candidate)) continue;
                        if (/^(rupture de stock|épuisé|epuise|ajouter|aperçu|accueil|maquillage|visage|cheveux|corps|parfum|bébé|bien-être|panier|catégories|rechercher|favoris)$/i.test(candidate)) continue;
                        if (/(\d+(?:[.,]\d+)?)\s*(?:MAD|DH|Dhs)\b/i.test(candidate)) break;
                        if (!nameLine) {
                            nameLine = candidate;
                        } else if (!brandLine && candidate.length <= 32) {
                            brandLine = candidate;
                            break;
                        }
                    }
                    if (nameLine && nameLine.length > 3) {
                        const brand = brandLine || (nameLine.includes('–') ? nameLine.split('–')[0].trim() : (nameLine.includes('-') ? nameLine.split('-')[0].trim() : nameLine.split(' ')[0]));
                        pushUnique({ brand, name: nameLine, price });
                    }
                }
            }

            return extracted;
        }

        // COLLAGE DIRECT (CTRL+V) DANS LE TABLEAU D'INVENTAIRE (SANS PASSER PAR LA CONSOLE)
        function handleDirectTablePaste(event) {
            const htmlData = event.clipboardData ? event.clipboardData.getData('text/html') : '';
            const textData = event.clipboardData ? event.clipboardData.getData('text/plain') : '';
            const combinedRaw = (htmlData && htmlData.trim().length > 20)
                ? (htmlData + "\n" + textData)
                : textData;

            if (!combinedRaw || combinedRaw.trim().length < 5) return;

            event.preventDefault();
            const dropzone = document.getElementById('quickClipboardDropzone');
            const insertedCount = insertExtractedItemsDirectlyIntoTable(combinedRaw);

            if (dropzone) {
                if (insertedCount > 0) {
                    dropzone.value = `✅ ${insertedCount} produit(s) Palmarosa ajoutés dans votre tableau ci-dessous ! Saisissez maintenant vos quantités dans la colonne "Mon Stock".`;
                } else {
                    dropzone.value = textData;
                }
            }
        }

        function triggerManualQuickPasteParse() {
            const dropzone = document.getElementById('quickClipboardDropzone');
            if (!dropzone) return;
            const raw = dropzone.value || dropzone.textContent || '';
            if (!raw.trim()) {
                showToast("Collez d'abord (Ctrl+V) les produits copiés depuis Palmarosa dans la case rose.");
