        function pushCmsUndoSnapshot() {
            cmsUndoStack.push(JSON.stringify(SITE_DATA));
            if (cmsUndoStack.length > MAX_CMS_HISTORY) cmsUndoStack.shift();
            cmsRedoStack = [];
            updateCmsHistoryButtons();
        }

        function updateCmsHistoryButtons() {
            const undoBtn = document.getElementById('cmsUndoBtn');
            const redoBtn = document.getElementById('cmsRedoBtn');
            const badge = document.getElementById('cmsUndoCountBadge');
            if (undoBtn) undoBtn.disabled = cmsUndoStack.length === 0;
            if (redoBtn) redoBtn.disabled = cmsRedoStack.length === 0;
            if (badge) {
                badge.textContent = cmsUndoStack.length;
                badge.classList.toggle('hidden', cmsUndoStack.length === 0);
            }
        }

        function goToCmsProductsPage(page) {
            cmsProductsCurrentPage = page;
            renderCmsProductsList();
            const panel = document.getElementById('cmsPanel-products');
            if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function undoCmsAction() {
            if (cmsUndoStack.length === 0) return;
            cmsRedoStack.push(JSON.stringify(SITE_DATA));
            const previousState = cmsUndoStack.pop();
            SITE_DATA = JSON.parse(previousState);
            selectedCmsProductIds.clear();
            saveCmsToLocalPreview(true);
            updateCmsHistoryButtons();
            showToast("↩️ Action annulée (Ctrl+Z)");
        }

        function redoCmsAction() {
            if (cmsRedoStack.length === 0) return;
            cmsUndoStack.push(JSON.stringify(SITE_DATA));
            const nextState = cmsRedoStack.pop();
            SITE_DATA = JSON.parse(nextState);
            selectedCmsProductIds.clear();
            saveCmsToLocalPreview(true);
            updateCmsHistoryButtons();
            showToast("↪️ Action rétablie (Ctrl+Y)");
        }

        document.addEventListener('keydown', function(e) {
            const overlay = document.getElementById('adminCmsOverlay');
            if (!isCmsAuthenticated || !overlay || overlay.classList.contains('hidden')) return;
            const tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : '';
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.target?.isContentEditable) return;

            const isMod = e.ctrlKey || e.metaKey;
            if (isMod && e.key.toLowerCase() === 'z' && !e.shiftKey) {
                e.preventDefault();
                undoCmsAction();
            } else if ((isMod && e.key.toLowerCase() === 'y') || (isMod && e.shiftKey && e.key.toLowerCase() === 'z')) {
                e.preventDefault();
                redoCmsAction();
            }
        });

