        function addToCart(productId) {
            const product = SITE_DATA.products.find(p => p.id === productId);
            if (!product) return;
            const availableQty = getProductStockQty(product);
            if (availableQty <= 0) {
                showToast("Ce soin est actuellement en rupture de stock.");
                return;
            }
            const existing = state.cart.find(item => item.id === productId);
            if (existing) {
                if (existing.qty >= availableQty) {
                    showToast(`Quantité maximale en stock atteinte (${availableQty})`);
                    return;
                }
                existing.qty += 1;
            } else {
                state.cart.push({ ...product, qty: 1 });
            }
            updateCartBadge();
            updateDeliverySimulator(state.selectedCity);
            showToast(`"${product.name.slice(0, 26)}..." ajouté au panier`);
        }

        function updateQty(productId, delta) {
            const item = state.cart.find(i => i.id === productId);
            if (!item) return;
            const product = SITE_DATA.products.find(p => p.id === productId);
            const maxStock = product ? getProductStockQty(product) : 99;
            if (delta > 0 && item.qty >= maxStock) {
                showToast(`Maximum disponible en stock : ${maxStock}`);
                return;
            }
            item.qty += delta;
            if (item.qty <= 0) state.cart = state.cart.filter(i => i.id !== productId);
            updateCartBadge();
            updateDeliverySimulator(state.selectedCity);
            renderCart();
        }

