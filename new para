        // ---- RECHERCHE : aperçu instantané (saisie) + résultats complets (Entrée / Chercher) ----
        function ptSearchProducts(q) {
            const tokens = ptTokens(q);
            if (!tokens.length) return [];
            const full = ptNorm(q).trim();
            const out = [];
            for (const p of SITE_DATA.products) {
                if (!ptProductMatches(p, tokens)) continue;
                const brand = ptNorm(p.brand), name = ptNorm(p.name);
                let score = 0;
                if (name.startsWith(full) || brand.startsWith(full)) score = 3;
                else if (name.includes(full) || brand.includes(full)) score = 2;
                else if (tokens.every(t => (brand + ' ' + name).includes(t))) score = 1;
                out.push({ p, score, inStock: getProductStockQty(p) > 0 });
            }
            out.sort((a, b) => (b.inStock - a.inStock) || (b.score - a.score));
            return out;
        }

        function ptCloseDropdowns() {
            document.querySelectorAll('.pt-search-dd').forEach(d => { d.classList.remove('open'); d.innerHTML = ''; });
        }

        function ptRenderDropdown(input, dd) {
            if (!input || !dd) return;
            const q = input.value.trim();
            if (!q) { dd.classList.remove('open'); dd.innerHTML = ''; return; }
            const results = ptSearchProducts(q);
            const safeQ = escapeHtmlAttr(q);
            if (results.length === 0) {
                dd.innerHTML = `<div class="pt-dd-empty">Aucun soin trouvé pour « <strong>${safeQ}</strong> ».<br>Essayez une marque (CeraVe, ISDIN…) ou un besoin (solaire, acné…).</div>`;
                dd.classList.add('open');
                return;
            }
            const rows = results.slice(0, 6).map(({ p }) => {
                const qty = getProductStockQty(p);
                const isOut = qty <= 0;
                const stock = isOut ? `<span class="pt-dd-stock out">Rupture</span>`
                    : (qty <= 3 ? `<span class="pt-dd-stock low">Plus que ${qty}</span>` : `<span class="pt-dd-stock ok">En stock</span>`);
                const img = (p.imageUrl && p.imageUrl.trim())
                    ? `<img onerror="handleImgError(this)" src="${escapeHtmlAttr(p.imageUrl)}" alt="${escapeHtmlAttr(p.name)}" loading="lazy">`
                    : `<img src="${PT_IMG_PLACEHOLDER}" alt="">`;
                const old = p.oldPrice && p.oldPrice > p.price ? `<span class="pt-dd-old">${p.oldPrice} DH</span>` : '';
                const btn = isOut
                    ? `<button type="button" class="pt-dd-add" disabled>Rupture</button>`
                    : `<button type="button" class="pt-dd-add" onclick="event.stopPropagation(); addToCart(${p.id})">+ Panier</button>`;
                return `<div class="pt-dd-row${isOut ? ' is-out' : ''}" role="option" onclick="ptOpenFromDropdown(${p.id})">
                    <div class="pt-dd-img">${img}</div>
                    <div class="pt-dd-body">
                        <div class="pt-dd-brand">${escapeHtmlAttr(p.brand)}</div>
                        <div class="pt-dd-name">${escapeHtmlAttr(p.name)}</div>
                        <div class="pt-dd-meta"><span class="pt-dd-price">${p.price} DH</span>${old}${stock}</div>
                    </div>
                    ${btn}
                </div>`;
            }).join('');
            const total = results.length;
            dd.innerHTML = `<div class="pt-dd-list">${rows}</div>
                <button type="button" class="pt-dd-foot" onclick="submitSearch(${JSON.stringify(q).replace(/"/g, '&quot;')})">
                    <span>Voir les ${total} résultat${total > 1 ? 's' : ''} pour « ${safeQ} »</span><span>Entrée ↵</span>
                </button>`;
            dd.classList.add('open');
        }

