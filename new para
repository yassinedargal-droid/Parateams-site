            return `
            <svg class="h-full max-h-[120px] sm:max-h-[280px] w-auto drop-shadow-xl transition-transform duration-500 group-hover/card:scale-105" viewBox="0 0 220 300" fill="none">
                <ellipse cx="110" cy="282" rx="48" ry="8" fill="#0D1310" fill-opacity="0.12"/>
