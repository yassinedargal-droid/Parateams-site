      for (let pageLoop = 1; pageLoop <= 40; pageLoop++) {
        renderBar('Page ' + pageLoop + ' en cours...');
        const steps = 4;
        for (let s = 1; s <= steps; s++) {
          window.scrollTo({ top: (document.body.scrollHeight / steps) * s, behavior: 'smooth' });
          await new Promise(r => setTimeout(r, 450));
