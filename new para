            const msg = `Bonjour ${SITE_DATA.settings.brandName} 👋,\nJe souhaite commander ce soin sur WhatsApp :\n• ${p.brand} — ${p.name} (${p.volume || ''})\n• Prix : ${p.price} DH\n• Ville de livraison : ${state.selectedCity}`;
            openWhatsAppDirect(msg);
