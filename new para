        function sendCartToWhatsApp() {
            if (state.cart.length === 0) return;
            const s = SITE_DATA.settings;
            const isCasa = state.selectedCity === 'Casablanca';
            const threshold = isCasa ? Number(s.casaThreshold) : Number(s.otherThreshold);
            const baseShipping = isCasa ? Number(s.casaFee) : Number(s.otherFee);
            const subtotal = state.cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const shippingCost = subtotal >= threshold ? 0 : baseShipping;
            const total = subtotal + shippingCost;
            const lines = state.cart.map(item => `• ${item.qty}x ${item.brand} ${item.name} = ${item.price * item.qty} DH`).join('\n');
            recordOrder({ customer: '', phone: '', address: '', source: 'WhatsApp' });
            const msg = `Bonjour ${s.brandName} 👋,\nVoici ma commande depuis votre boutique en ligne :\n\n${lines}\n\n• Ville : ${state.selectedCity}\n• Livraison : ${shippingCost === 0 ? 'Offerte' : shippingCost + ' DH'}\n• Total à régler : ${total} DH`;
            openWhatsAppDirect(msg);
        }

