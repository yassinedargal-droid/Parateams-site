        function saveCmsProduct(e) {
            e.preventDefault();
            pushCmsUndoSnapshot();
            const idVal = document.getElementById('editProdId').value;
            const oldPriceVal = document.getElementById('editProdOldPrice').value;
            const badgeVal = document.getElementById('editProdBadge').value.trim();
            const isNewVal = document.getElementById('editProdIsNew').checked;
            const stockQtyVal = Math.max(0, Math.floor(Number(document.getElementById('editProdStockQty').value) || 0));

            const prodObj = syncProductStockFields({
                id: idVal ? Number(idVal) : (Math.max(0, ...SITE_DATA.products.map(p => p.id)) + 1),
                brand: document.getElementById('editProdBrand').value.trim(),
                category: document.getElementById('editProdCategory').value,
                name: document.getElementById('editProdName').value.trim(),
                price: Number(document.getElementById('editProdPrice').value),
                oldPrice: oldPriceVal ? Number(oldPriceVal) : null,
                badge: badgeVal || null,
                badgeType: oldPriceVal ? 'promo' : (isNewVal ? 'new' : 'best'),
                isNew: isNewVal,
                volume: document.getElementById('editProdVolume').value.trim(),
                benefit: document.getElementById('editProdBenefit').value.trim(),
                description: document.getElementById('editProdDesc').value.trim(),
                imageUrl: document.getElementById('editProdImageUrl').value.trim(),
                concern: "Hydratation",
                skinType: "Tous types",
                rating: 4.9,
                reviewsCount: 15,
                color: "#5D9C2A",
                shape: "bottle"
            }, stockQtyVal);

            if (idVal) {
                const idx = SITE_DATA.products.findIndex(p => p.id === Number(idVal));
                if (idx > -1) SITE_DATA.products[idx] = { ...SITE_DATA.products[idx], ...prodObj };
            } else {
                SITE_DATA.products.unshift(prodObj);
            }

            closeCmsProductEditor();
            saveCmsToLocalPreview();
        }

        function duplicateCmsProduct(id) {
            const orig = SITE_DATA.products.find(p => p.id === id);
            if (!orig) return;
            pushCmsUndoSnapshot();
            const copy = {
                ...orig,
                id: Math.max(0, ...SITE_DATA.products.map(p => p.id)) + 1,
                name: orig.name + " (Copie)"
            };
            SITE_DATA.products.unshift(copy);
            saveCmsToLocalPreview();
        }

