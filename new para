        function getValidRayonName(rawCat, productHintObj = null) {
            const validRayons = SITE_DATA.rayons.filter(r => !r.isBudget).map(r => r.name);
            const forcedOrAuto = document.getElementById('bulkDefaultRayonSelect')?.value || 'auto';

            if (forcedOrAuto && forcedOrAuto !== 'auto') {
