                        </select>
                    </td>
                </tr>
            `).join('');
        }

        function updateBulkStagingCounts() {
            const selEl = document.getElementById('bulkStagingSelectedCount');
            if (selEl) selEl.textContent = bulkStagedProducts.filter(p => p.selected).length;
        }

        function toggleAllBulkStaged(checked) {
            bulkStagedProducts.forEach(item => item.selected = checked);
            renderBulkStagingTable();
