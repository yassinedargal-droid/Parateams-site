            try {
                const saved = localStorage.getItem(CMS_STORAGE_KEY);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    document.getElementById('cmsPreviewBanner').classList.remove('hidden');

                    const mergedRayons = [...STANDARD_PARATEAMS_RAYONS];
                    if (Array.isArray(parsed.rayons)) {
                        parsed.rayons.forEach(r => {
                            if (r && r.name && !r.isBudget && !["Cheveux & Hygiène", "Bébés & Maman", "Corps"].includes(r.name)) {
                                if (!mergedRayons.some(m => m.name === r.name)) {
                                    mergedRayons.splice(mergedRayons.length - 1, 0, r);
                                }
                            }
                        });
                    }

                    const preservedProducts = Array.isArray(parsed.products) && parsed.products.length > 0
                        ? parsed.products.map(p => {
                            const copy = { ...p, category: normalizeCategoryName(p.category) };
                            return syncProductStockFields(copy, getProductStockQty(copy));
                        })
                        : defaultData.products;

                    return {
                        ...defaultData,
                        ...parsed,
                        rayons: mergedRayons,
                        products: preservedProducts
                    };
                }
            } catch (e) {
                console.warn("Cache CMS corrompu ignoré et réinitialisé", e);
                localStorage.removeItem(CMS_STORAGE_KEY);
            }
            return defaultData;
        }

