                        <input type="text" value="${escapeHtmlAttr(item.brand)}" onchange="bulkStagedProducts[${idx}].brand = this.value" class="w-28 px-2 py-1 rounded border border-slate-200 text-xs font-bold">
                    </td>
                    <td class="p-2.5">
                        <input type="text" value="${escapeHtmlAttr(item.name)}" onchange="bulkStagedProducts[${idx}].name = this.value" class="w-full min-w-[180px] px-2 py-1 rounded border border-slate-200 text-xs">
                    </td>
                    <td class="p-2.5">
                        <input type="number" value="${item.price}" onchange="bulkStagedProducts[${idx}].price = Number(this.value)" class="w-20 px-2 py-1 rounded border border-slate-200 text-xs font-bold text-sage-900">
                    </td>
                    <td class="p-2.5">
                        <input type="number" min="0" value="${item.stockQty ?? 10}" onchange="bulkStagedProducts[${idx}].stockQty = Math.max(0, Number(this.value))" class="w-16 px-2 py-1 rounded border border-sage-400 bg-sage-50/50 text-xs font-extrabold text-center text-sage-900">
                    </td>
                    <td class="p-2.5">
                        <select onchange="bulkStagedProducts[${idx}].category = this.value" class="px-2 py-1 rounded border border-slate-200 text-xs bg-white">
