        function saveCmsToLocalPreview(silent = false) {
            try {
                localStorage.setItem(CMS_STORAGE_KEY, JSON.stringify(SITE_DATA));
            } catch (err) {
                console.warn("Quota localStorage atteint", err);
            }
            document.getElementById('cmsPreviewBanner').classList.remove('hidden');
            applyStoreSettingsToUI();
            renderHeroSlides();
            renderProducts();
            updateDeliverySimulator(state.selectedCity);
            refreshAllCmsPanels();
            updateCmsHistoryButtons();
            if (!silent) showToast("Modifications appliquées sur la boutique !");
        }

        function updateCmsInventoryStats() {
            const total = SITE_DATA.products.length;
            let inStock = 0, lowStock = 0, outStock = 0;
            SITE_DATA.products.forEach(p => {
                const q = getProductStockQty(p);
                if (q === 0) outStock++;
                else if (q <= 3) lowStock++;
                else inStock++;
            });
            const elTotal = document.getElementById('cmsStatTotalProd');
            const elIn = document.getElementById('cmsStatInStock');
            const elLow = document.getElementById('cmsStatLowStock');
            const elOut = document.getElementById('cmsStatOutStock');
            if (elTotal) elTotal.textContent = total;
            if (elIn) elIn.textContent = inStock;
            if (elLow) elLow.textContent = lowStock;
            if (elOut) elOut.textContent = outStock;
        }

        function setCmsStockFilterQuick(filterVal) {
            const sel = document.getElementById('cmsProdStockFilter');
            if (sel) {
                sel.value = filterVal;
                cmsProductsCurrentPage = 1;
                renderCmsProductsList();
            }
        }

        function recategorizeAllExistingProducts() {
            if (!SITE_DATA.products || SITE_DATA.products.length === 0) return;
            pushCmsUndoSnapshot();
            let updatedCount = 0;
            SITE_DATA.products = SITE_DATA.products.map(p => {
                const detected = autoDetectProductRayon(p);
                if (detected && detected !== p.category) updatedCount++;
                return { ...p, category: detected };
            });
            saveCmsToLocalPreview(true);
            showToast(`✨ ${SITE_DATA.products.length} produits analysés (${updatedCount} reclassés dans leur bon rayon) !`);
        }

        function bulkMoveSelectedCmsProducts() {
            const targetRayon = document.getElementById('cmsBulkMoveRayonSelect')?.value;
            if (!targetRayon) {
                showToast("Choisissez d'abord un rayon de destination.");
                return;
            }
            if (selectedCmsProductIds.size === 0) {
                showToast("Sélectionnez au moins un produit.");
                return;
            }
            pushCmsUndoSnapshot();
            const count = selectedCmsProductIds.size;
            SITE_DATA.products = SITE_DATA.products.map(p =>
                selectedCmsProductIds.has(p.id) ? { ...p, category: targetRayon } : p
            );
            selectedCmsProductIds.clear();
            saveCmsToLocalPreview(true);
            showToast(`📂 ${count} produit(s) déplacé(s) vers "${targetRayon}"`);
        }

        function adjustCmsProductStock(id, delta) {
            const p = SITE_DATA.products.find(x => x.id === id);
            if (!p) return;
            pushCmsUndoSnapshot();
            syncProductStockFields(p, getProductStockQty(p) + delta);
            saveCmsToLocalPreview(true);
        }

        function setCmsProductStockDirect(id, rawVal) {
            const p = SITE_DATA.products.find(x => x.id === id);
            if (!p) return;
            pushCmsUndoSnapshot();
            syncProductStockFields(p, rawVal);
            saveCmsToLocalPreview(true);
            showToast(`Stock mis à jour : ${p.stockQty} unité(s)`);
        }

        function updateCmsProductInlineField(id, field, value) {
            const p = SITE_DATA.products.find(x => x.id === id);
            if (!p) return;
            pushCmsUndoSnapshot();
            if (field === 'price') {
                p.price = Math.max(1, parsePriceNumber(value) || p.price);
            } else if (field === 'category') {
                p.category = value;
            } else if (field === 'name') {
                p.name = String(value).trim() || p.name;
            } else if (field === 'brand') {
                p.brand = String(value).trim() || p.brand;
            }
            saveCmsToLocalPreview(true);
        }

        function handleStockInputKeydown(event, idxOnPage) {
            if (event.key === 'Enter') {
                event.preventDefault();
                event.target.blur();
                const nextInput = document.querySelector(`[data-stock-row="${idxOnPage + 1}"]`);
                if (nextInput) {
                    nextInput.focus();
                    nextInput.select();
                }
            }
        }

        function bulkSetSelectedStockQty() {
            if (selectedCmsProductIds.size === 0) {
                showToast("Sélectionnez d'abord un ou plusieurs produits.");
                return;
            }
            const qty = Math.max(0, Math.floor(Number(document.getElementById('cmsBulkStockQtyInput')?.value) || 0));
            pushCmsUndoSnapshot();
            const count = selectedCmsProductIds.size;
            SITE_DATA.products = SITE_DATA.products.map(p =>
                selectedCmsProductIds.has(p.id) ? syncProductStockFields({ ...p }, qty) : p
            );
            selectedCmsProductIds.clear();
            saveCmsToLocalPreview(true);
            showToast(`📦 Stock fixé à ${qty} unité(s) pour ${count} produit(s) !`);
        }

        function getFilteredCmsProducts() {
            const q = (document.getElementById('cmsProdSearch')?.value || '').trim().toLowerCase();
            const rayonFilter = document.getElementById('cmsProdRayonFilter')?.value || 'all';
            const stockFilter = document.getElementById('cmsProdStockFilter')?.value || 'all';

            return SITE_DATA.products.filter(p => {
                const qty = getProductStockQty(p);
                const matchRayon = rayonFilter === 'all' || p.category === rayonFilter;
                const matchQuery = !q || p.name.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q) || p.category.toLowerCase().includes(q);
                let matchStock = true;
                if (stockFilter === 'out') matchStock = qty === 0;
                else if (stockFilter === 'low') matchStock = qty > 0 && qty <= 3;
                else if (stockFilter === 'in') matchStock = qty >= 4;
                return matchRayon && matchQuery && matchStock;
            });
        }

        function updateCmsBulkSelectionUI() {
            const validIds = new Set(SITE_DATA.products.map(p => p.id));
            selectedCmsProductIds.forEach(id => {
                if (!validIds.has(id)) selectedCmsProductIds.delete(id);
            });
            const count = selectedCmsProductIds.size;
            const badge = document.getElementById('cmsSelectedProdBadge');
            const delBtn = document.getElementById('cmsBulkDeleteBtn');
            const delCount = document.getElementById('cmsBulkDeleteCount');
            if (badge) badge.textContent = `${count} sélectionné${count > 1 ? 's' : ''}`;
            if (delCount) delCount.textContent = count;
            if (delBtn) delBtn.disabled = count === 0;
        }

