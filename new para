        function parseDelimitedLine(line, delimiter) {
            const result = [];
            let current = '';
            let inQuotes = false;
            for (let i = 0; i < line.length; i++) {
                const ch = line[i];
                if (ch === '"') {
                    inQuotes = !inQuotes;
                } else if (ch === delimiter && !inQuotes) {
                    result.push(current.trim());
                    current = '';
                } else {
                    current += ch;
                }
            }
            result.push(current.trim());
            return result;
        }

        async function handleBulkCsvUpload(event) {
            const files = Array.from(event.target.files || []);
            if (files.length === 0) return;

            const defaultStock = getDefaultInitialStock();
            const parsedItems = [];

            for (const file of files) {
                const text = (await file.text()).replace(/^\uFEFF/, '');
                const trimmed = text.trim();
                if (!trimmed) continue;

                if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
                    const fromJson = parseProductsFromHtmlOrJson(trimmed);
                    parsedItems.push(...fromJson);
                    continue;
                }

                const lines = trimmed.split(/\r?\n/).filter(l => l.trim().length > 0);
                if (lines.length === 0) continue;

                const firstLine = lines[0];
                const delimiter = firstLine.includes(';') ? ';' : (firstLine.includes('\t') ? '\t' : ',');
                const lowerFirst = firstLine.toLowerCase();
                const hasHeader = lowerFirst.includes('name') || lowerFirst.includes('nom') || lowerFirst.includes('brand') || lowerFirst.includes('marque') || lowerFirst.includes('price') || lowerFirst.includes('prix');
                const startIdx = hasHeader ? 1 : 0;

                for (let i = startIdx; i < lines.length; i++) {
                    const cols = parseDelimitedLine(lines[i], delimiter);
                    if (cols.length < 2) continue;
                    const brand = cols[0] || "Parateams";
                    const name = cols[1] || "";
                    const price = parsePriceNumber(cols[2]);
                    const oldPrice = parsePriceNumber(cols[3]) || null;
                    const category = getValidRayonName(cols[4], { name, brand });
                    const imageUrl = cols[5] || "";
                    const badge = cols[6] || (oldPrice && oldPrice > price ? `-${Math.round((1 - price / oldPrice) * 100)}%` : "");
                    const stockQty = cols[7] !== undefined && cols[7] !== '' ? parsePriceNumber(cols[7]) : defaultStock;
                    const description = cols[8] || `${brand} — ${name}`;

                    if (name && price > 0) {
                        parsedItems.push({ selected: true, brand, name, price, oldPrice, category, imageUrl, badge, stockQty, description });
                    }
                }
            }

            event.target.value = '';
            stageProductsForPreview(parsedItems, true);
        }

        function parseRawLinesToProductObjects(rawText) {
            const lines = (rawText || '').split(/\r?\n/).map(l => l.trim()).filter(Boolean);
            const items = [];
            const defaultStock = getDefaultInitialStock();

            for (const line of lines) {
                const delimiter = line.includes('|') ? '|' : (line.includes('\t') ? '\t' : ';');
                const cols = line.split(delimiter).map(c => c.trim());
                if (cols.length >= 3) {
                    const brand = cols[0] || "Parateams";
                    const name = cols[1] || "";
                    const price = parsePriceNumber(cols[2]);
                    const oldPrice = parsePriceNumber(cols[3]) || null;
                    const category = getValidRayonName(cols[4], { name, brand });
                    const imageUrl = cols[5] || "";
                    const stockQty = cols[6] !== undefined && cols[6] !== '' ? parsePriceNumber(cols[6]) : defaultStock;
                    if (name && price > 0) {
                        items.push({
                            selected: true,
                            brand,
                            name,
                            price,
                            oldPrice,
                            category,
                            imageUrl,
                            stockQty,
                            badge: oldPrice && oldPrice > price ? `-${Math.round((1 - price / oldPrice) * 100)}%` : "",
                            description: `${brand} — ${name}`
                        });
                    }
                }
            }
            return items;
        }

