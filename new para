        async function extractFromExternalUrl() {
            const urlInput = document.getElementById('scrapeUrlInput');
            const statusEl = document.getElementById('scrapeUrlStatus');
            const btn = document.getElementById('scrapeUrlBtn');
            const targetUrl = (urlInput.value || '').trim();

            if (!targetUrl) {
                showToast("Veuillez entrer un lien URL valide.");
                return;
            }

            btn.disabled = true;
            btn.textContent = "⏳ Extraction en cours...";
            statusEl.innerHTML = "Connexion au site distant et recherche des produits...";

            try {
                const parsedUrl = new URL(targetUrl);
                const cleanPath = parsedUrl.pathname.replace(/\/$/, '');
                const candidates = [
                    `https://api.allorigins.win/raw?url=${encodeURIComponent(parsedUrl.origin + cleanPath + '/products.json?limit=250')}`,
                    `https://api.allorigins.win/raw?url=${encodeURIComponent(targetUrl)}`,
                    `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(targetUrl)}`
                ];

                let items = [];
                for (const proxyUrl of candidates) {
                    try {
                        const res = await fetch(proxyUrl);
                        if (res.ok) {
                            const text = await res.text();
                            if (text && text.length > 50) {
                                items = parseProductsFromHtmlOrJson(text);
                                if (items.length > 0) break;
                            }
                        }
                    } catch (err) {}
                }

                if (items.length === 0) {
                    throw new Error("Ce site charge ses produits dynamiquement.");
                }

                stageProductsForPreview(items, true);
                statusEl.innerHTML = `<span class="text-sage-700 font-bold">✅ ${items.length} produit(s) extrait(s) et ajoutés à la liste ci-dessous !</span>`;
            } catch (err) {
                statusEl.innerHTML = `<span class="text-coral-600 font-bold">⚠️ Utilisez le Mode B à droite (bouton "Copier le script Console") pour extraire tous les produits en 1 clic.</span>`;
            } finally {
                btn.disabled = false;
                btn.textContent = "🔍 Extraire depuis ce lien URL";
            }
        }

        function extractProductsFromPastedSource(appendMode = false) {
            const raw = document.getElementById('scrapeHtmlSourceInput').value;
            if (!raw || raw.trim() === '') {
                showToast("Collez d'abord le résultat du script Console ou le JSON.");
                return;
            }
            const items = parseProductsFromHtmlOrJson(raw);
            if (items.length === 0) {
                showToast("Aucun produit détecté.");
                return;
            }
            stageProductsForPreview(items, appendMode);
            document.getElementById('scrapeHtmlSourceInput').value = '';
        }

        function stageProductsForPreview(items, appendMode = false) {
            if (!items || items.length === 0) {
                showToast("Aucun produit valide détecté.");
                return;
            }
            if (appendMode && bulkStagedProducts.length > 0) {
                const existingNames = new Set(bulkStagedProducts.map(p => p.name.toLowerCase()));
                const uniqueNew = items.filter(p => !existingNames.has(p.name.toLowerCase()));
                bulkStagedProducts = [...bulkStagedProducts, ...uniqueNew.map(x => ({ ...x, selected: true }))];
            } else {
                bulkStagedProducts = items.map(x => ({ ...x, selected: true }));
            }
            document.getElementById('bulkStagingBox').classList.remove('hidden');
            renderBulkStagingTable();
            document.getElementById('bulkStagingBox').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            showToast(`${bulkStagedProducts.length} produit(s) prêts dans la liste d'importation !`);
        }

