    <style id="pt-enhancements">
        /* --- Recherche : aperçu instantané --- */
        .pt-search-dd{position:absolute;left:0;right:0;top:calc(100% + 8px);background:#fff;border:1px solid #e2e8f0;border-radius:20px;box-shadow:0 24px 60px -14px rgba(13,19,16,.32);z-index:80;overflow:hidden;display:none}
        .pt-search-dd.open{display:block}
        #mobileSearchDropdown{top:calc(100% - 4px)}
        .pt-dd-list{max-height:min(62vh,430px);overflow-y:auto;overscroll-behavior:contain}
        .pt-dd-row{display:flex;align-items:center;gap:12px;padding:10px 14px;cursor:pointer;border-bottom:1px solid #f1f5f9;text-align:left}
        .pt-dd-row:hover{background:#F4F9F0}
        .pt-dd-row.is-out{opacity:.72}
        .pt-dd-img{width:54px;height:54px;flex:none;border-radius:12px;background:#F4F9F0;display:flex;align-items:center;justify-content:center;overflow:hidden}
        .pt-dd-img img{max-width:100%;max-height:100%;object-fit:contain}
        .pt-dd-body{flex:1;min-width:0}
        .pt-dd-brand{font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#4E8422;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .pt-dd-name{font-size:13px;font-weight:700;color:#0f172a;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
        .pt-dd-meta{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;margin-top:3px;font-size:11.5px}
        .pt-dd-price{font-weight:800;color:#1D330C;font-size:13px}
        .pt-dd-old{color:#94a3b8;text-decoration:line-through}
        .pt-dd-stock{font-weight:700;display:inline-flex;align-items:center;gap:4px}
        .pt-dd-stock::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
        .pt-dd-stock.ok{color:#3E6B1B}.pt-dd-stock.low{color:#d97706}.pt-dd-stock.out{color:#C8563D}
        .pt-dd-add{flex:none;border:0;border-radius:999px;background:#3E6B1B;color:#fff;font-size:12px;font-weight:700;padding:8px 14px;cursor:pointer;white-space:nowrap}
        .pt-dd-add:hover{background:#1D330C}
        .pt-dd-add:disabled{background:#e2e8f0;color:#94a3b8;cursor:not-allowed}
        .pt-dd-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;padding:11px 16px;background:#F4F9F0;border:0;border-top:1px solid #E5F2DB;color:#1D330C;font-size:12.5px;font-weight:800;cursor:pointer;text-align:left}
        .pt-dd-foot:hover{background:#E5F2DB}
        .pt-dd-empty{padding:18px 16px;font-size:13px;color:#475569;text-align:center}
        .pt-search-btn{flex:none;margin:4px 4px 4px 0;border:0;border-radius:999px;background:#3E6B1B;color:#fff;font-size:12.5px;font-weight:800;padding:7px 16px;cursor:pointer}
        .pt-search-btn:hover{background:#1D330C}
        /* --- Rupture de stock --- */
        .pt-badge-out{position:absolute;top:10px;left:10px;z-index:10;padding:3px 10px;border-radius:999px;background:#0D1310;color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase}
        .pt-out-visual{filter:grayscale(.85);opacity:.75}
        .pt-img-fallback{opacity:.9}
        /* --- CMS commandes --- */
        .pt-order-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;padding:16px}
        .pt-order-card[data-status="Nouvelle"]{border-color:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.12)}
        .pt-status{display:inline-block;padding:2px 10px;border-radius:999px;font-size:11px;font-weight:800}
        .pt-status.s-Nouvelle{background:#fef3c7;color:#92400e}.pt-status.s-Confirmée{background:#dbeafe;color:#1e40af}
        .pt-status.s-Expédiée{background:#ede9fe;color:#5b21b6}.pt-status.s-Livrée{background:#E5F2DB;color:#1D330C}
        .pt-status.s-Annulée{background:#fee2e2;color:#991b1b}
    </style>
    <script>
        /* Sécurité anti-image cassée : toute image qui échoue est remplacée par un visuel de secours */
        (function () {
            var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none"><circle cx="60" cy="60" r="48" fill="#F4F9F0"/><rect x="40" y="38" width="40" height="58" rx="12" fill="#fff" stroke="#3E6B1B" stroke-width="2"/><rect x="52" y="25" width="16" height="13" rx="3" fill="#5D9C2A" stroke="#3E6B1B" stroke-width="2"/><rect x="46" y="50" width="28" height="34" rx="5" fill="#5D9C2A" fill-opacity=".12"/><circle cx="60" cy="64" r="6" fill="#5D9C2A"/></svg>';
            window.PT_IMG_PLACEHOLDER = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
            window.handleImgError = function (img) {
                if (!img || (img.dataset && img.dataset.ptFallback)) return;
                img.dataset.ptFallback = '1';
                img.onerror = null;
                img.removeAttribute('srcset');
                img.classList.add('pt-img-fallback');
                img.src = window.PT_IMG_PLACEHOLDER;
            };
            document.addEventListener('error', function (e) {
                var t = e.target;
                if (t && t.tagName === 'IMG') window.handleImgError(t);
            }, true);
            window.ptFixBrokenImages = function (root) {
                (root || document).querySelectorAll('img').forEach(function (i) {
                    var s = i.getAttribute('src') || '';
                    if (s && s.indexOf('data:') !== 0 && i.complete && i.naturalWidth === 0) window.handleImgError(i);
                });
            };
        })();
    </script>
