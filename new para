        function downloadTextFile(content, filename, mime) {
            const blob = new Blob([content], { type: mime });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = filename; a.click();
            URL.revokeObjectURL(url);
        }
        function exportOrdersCsv() {
            const orders = loadOrders();
            if (!orders.length) { showToast('Aucune commande à exporter.'); return; }
            const esc = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
            const head = ['Réf', 'Date', 'Statut', 'Source', 'Client', 'Téléphone', 'Ville', 'Adresse', 'Articles', 'Sous-total', 'Livraison', 'Total'];
            const rows = orders.map(o => [o.id, o.date, o.status, o.source, o.customer, o.phone, o.city, o.address,
                (o.items || []).map(i => `${i.qty}x ${i.brand} ${i.name}`).join(' | '), o.subtotal, o.shipping, o.total].map(esc).join(';'));
            downloadTextFile('﻿' + [head.map(esc).join(';')].concat(rows).join('\r\n'), `commandes-parateams-${new Date().toISOString().slice(0, 10)}.csv`, 'text/csv;charset=utf-8');
        }
        function exportOrdersJson() {
            downloadTextFile(JSON.stringify(loadOrders(), null, 2), `commandes-parateams-${new Date().toISOString().slice(0, 10)}.json`, 'application/json');
        }
        function importOrdersJson(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = () => {
                try {
                    const incoming = JSON.parse(reader.result);
                    if (!Array.isArray(incoming)) throw new Error('format');
                    const list = loadOrders();
                    const known = new Set(list.map(o => o.id));
                    let added = 0;
                    incoming.forEach(o => { if (o && o.id && Array.isArray(o.items) && !known.has(o.id)) { list.push(o); known.add(o.id); added++; } });
                    list.sort((a, b) => String(b.date).localeCompare(String(a.date)));
                    saveOrders(list);
                    renderCmsOrders();
                    showToast(`${added} commande(s) importée(s).`);
                } catch (err) { showToast('Fichier de commandes invalide.'); }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

