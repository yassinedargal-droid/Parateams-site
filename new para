  scanPage();

  let bar = document.getElementById('pt-extract-bar');
  if (!bar) {
    bar = document.createElement('div');
    bar.id = 'pt-extract-bar';
    bar.style.cssText = 'position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:999999;display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px;background:#0D1310;color:#fff;border-radius:16px;box-shadow:0 15px 35px rgba(0,0,0,0.5);align-items:center;font-family:sans-serif;border:2px solid #5D9C2A;';
    document.body.appendChild(bar);
  }

  let isAutoRunning = false;

  const renderBar = (statusText = '') => {
    const all = Array.from(window.__PARATEAMS_BAG.values());
    bar.innerHTML = '';

    const autoAllBtn = document.createElement('button');
    autoAllBtn.textContent = isAutoRunning ? ('⏳ ' + (statusText || 'Aspiration des pages...')) : '🚀 Aspirer TOUTES les pages (1 → Fin)';
    autoAllBtn.style.cssText = 'padding:10px 15px;background:#e11d48;color:#fff;font-weight:bold;border:none;border-radius:10px;cursor:pointer;font-size:13px;';
    autoAllBtn.onclick = async () => {
      if (isAutoRunning) return;
