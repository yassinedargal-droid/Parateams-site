            }).join('');

            dotsContainer.innerHTML = slides.map((_, idx) => `
                <button onclick="goToHeroSlide(${idx})" aria-label="Slide ${idx + 1}" class="hero-dot ${idx === currentHeroSlide ? 'active h-2 w-9 sm:w-10 bg-white' : 'h-2 w-3 bg-white/35 hover:bg-white/60'} rounded-full transition-all duration-300 cursor-pointer"></button>
            `).join('');
        }

        // CATALOGUE PRODUITS
        function ptNorm(s) {
            return String(s || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        }
        function ptTokens(q) {
            return ptNorm(q).split(/\s+/).filter(Boolean);
        }
        function ptProductMatches(p, tokens) {
            if (!tokens || tokens.length === 0) return true;
            const hay = ptNorm([p.brand, p.name, p.category, p.concern, p.benefit].join(' '));
            return tokens.every(t => hay.includes(t));
        }

        function getFilteredProducts() {
            const searchTokens = ptTokens(state.search);
            return SITE_DATA.products.filter(p => {
                const matchCat = state.category === 'all' || p.category === state.category;
                const matchBrand = state.brand === 'all' || p.brand.toLowerCase() === state.brand.toLowerCase();
                const matchPromo = !state.promoOnly || (p.oldPrice !== null && p.oldPrice > 0);
                const matchBudget = !state.budget99Only || p.price <= 99;
                const matchNew = !state.newOnly || p.isNew === true;
                const matchConcern = !state.concernFilter || p.concern === state.concernFilter;
                
                const matchSearch = ptProductMatches(p, searchTokens);

                return matchCat && matchBrand && matchPromo && matchBudget && matchNew && matchConcern && matchSearch;
            });
        }

        function renderProducts() {
            const grid = document.getElementById('productsGrid');
            const emptyState = document.getElementById('emptyState');
            const paginationEl = document.getElementById('catalogPagination');
            const countText = document.getElementById('productCountText');
            const titleEl = document.getElementById('catalogTitle');
            const resetBadgeBtn = document.getElementById('resetBadgeBtn');
            const sortVal = document.getElementById('sortSelect').value;

            let filtered = getFilteredProducts();

            if (sortVal === 'price-asc') filtered.sort((a, b) => a.price - b.price);
            else if (sortVal === 'price-desc') filtered.sort((a, b) => b.price - a.price);
            else if (sortVal === 'rating') filtered.sort((a, b) => (b.rating || 5) - (a.rating || 5));

            // Produits en stock toujours en premier (quel que soit le tri), ruptures tout en bas
            const _inStock = [], _outStock = [];
            filtered.forEach(p => (getProductStockQty(p) > 0 ? _inStock : _outStock).push(p));
            filtered = _inStock.concat(_outStock);

            const hasActiveFilter = state.category !== 'all' || state.brand !== 'all' || state.promoOnly || state.budget99Only || state.newOnly || state.concernFilter || state.search.trim() !== '';
            resetBadgeBtn.classList.toggle('hidden', !hasActiveFilter);

            // Le grand slider disparaît dès qu'un rayon / filtre / recherche est actif
            const heroSectionEl = document.getElementById('heroSection');
            if (heroSectionEl) heroSectionEl.classList.toggle('hidden', !!hasActiveFilter);

            if (state.search.trim()) titleEl.textContent = `Résultats pour « ${state.search.trim()} »`;
            else if (state.concernFilter) titleEl.textContent = `Sélection : ${state.concernFilter}`;
            else if (state.budget99Only) titleEl.textContent = "Soins Petit Budget (≤ 99 DH)";
            else if (state.promoOnly) titleEl.textContent = "Promotions & Offres Spéciales";
            else if (state.newOnly) titleEl.textContent = "Nouveautés Dermo-Cosmétiques";
            else if (state.brand !== 'all') titleEl.textContent = `Laboratoire ${state.brand}`;
            else if (state.category !== 'all') titleEl.textContent = `Rayon ${state.category}`;
            else titleEl.textContent = "Meilleures Ventes & Nouveautés";

            renderRayons();

            if (filtered.length === 0) {
                grid.innerHTML = '';
                if (paginationEl) paginationEl.innerHTML = '';
                countText.textContent = '0 soin disponible';
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            const totalPages = Math.max(1, Math.ceil(filtered.length / state.itemsPerPage));
            if (state.currentPage > totalPages) state.currentPage = totalPages;
            if (state.currentPage < 1) state.currentPage = 1;

            const startIdx = (state.currentPage - 1) * state.itemsPerPage;
            const paginatedItems = filtered.slice(startIdx, startIdx + state.itemsPerPage);

            countText.textContent = filtered.length > state.itemsPerPage
                ? `Affichage de ${startIdx + 1}–${Math.min(startIdx + state.itemsPerPage, filtered.length)} sur ${filtered.length} soins`
                : `${filtered.length} soin${filtered.length > 1 ? 's' : ''} disponible${filtered.length > 1 ? 's' : ''}`;

            grid.innerHTML = paginatedItems.map(product => {
                const qty = getProductStockQty(product);
                const isOut = qty === 0;

                let badgeColorClass = 'bg-sage-100 text-sage-800';
                if (product.badgeType === 'promo' || (product.oldPrice && product.oldPrice > product.price)) badgeColorClass = 'bg-coral-500 text-white';
                if (product.badgeType === 'new' || product.isNew) badgeColorClass = 'bg-sage-700 text-white';

                const badgeHTML = isOut ? `<span class="pt-badge-out">Rupture</span>` : product.badge ? `
                    <span class="absolute top-2.5 left-2.5 sm:top-3.5 sm:left-3.5 z-10 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-[10px] sm:text-[11px] font-extrabold tracking-wide ${badgeColorClass}">
                        ${escapeHtmlAttr(product.badge)}
                    </span>
                ` : '';

                const oldPriceHTML = product.oldPrice ? `
                    <span class="text-[11px] sm:text-xs text-slate-400 line-through ml-1">${product.oldPrice} DH</span>
                ` : '';

                const isLiked = state.wishlist.includes(product.id);
                const stockHTML = isOut
                    ? `<span class="inline-flex items-center gap-1 text-[10.5px] sm:text-[11px] font-bold text-coral-600"><span class="w-1.5 h-1.5 rounded-full bg-coral-500"></span>Rupture</span>`
                    : (qty <= 3
                        ? `<span class="inline-flex items-center gap-1 text-[10.5px] sm:text-[11px] font-semibold text-amber-600"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>Plus que ${qty}</span>`
                        : `<span class="inline-flex items-center gap-1 text-[10.5px] sm:text-[11px] font-semibold text-sage-700"><span class="w-1.5 h-1.5 rounded-full bg-sage-500"></span>En stock (${qty})</span>`);

                const addButtonHTML = isOut
                    ? `<button disabled class="px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-full bg-slate-100 text-slate-400 text-[11px] sm:text-xs font-bold cursor-not-allowed shrink-0">Épuisé</button>`
                    : `<button onclick="addToCart(${product.id})" class="px-2.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-sage-700 hover:bg-sage-800 active:scale-95 text-white text-[11px] sm:text-sm font-semibold shadow-xs transition flex items-center gap-1 cursor-pointer shrink-0"><span>+ Ajouter</span></button>`;

                return `
                <article class="group bg-white rounded-2xl sm:rounded-3xl border border-slate-100 p-3 sm:p-5 shadow-xs hover:shadow-lg hover:border-sage-200 transition-all duration-300 flex flex-col justify-between relative ${isOut ? 'opacity-80' : ''}">
                    <div>
                        ${badgeHTML}
                        <div class="absolute top-2.5 right-2.5 sm:top-3.5 sm:right-3.5 z-10 flex items-center gap-1">
                            <button onclick="toggleWishlist(${product.id})" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/95 border border-slate-200 ${isLiked ? 'text-coral-500 border-coral-200 bg-coral-50/50' : 'text-slate-400 hover:text-coral-500'} flex items-center justify-center shadow-xs transition cursor-pointer" title="Ajouter aux favoris">
                                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="${isLiked ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                            </button>
                            <button onclick="openQuickView(${product.id})" class="hidden sm:flex w-8 h-8 rounded-full bg-white/95 border border-slate-200 text-slate-500 hover:text-sage-800 hover:border-sage-400 items-center justify-center shadow-xs transition cursor-pointer" title="Aperçu rapide & conseils">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            </button>
                        </div>

                        <div onclick="openQuickView(${product.id})" class="pt-4 pb-2 sm:pt-5 sm:pb-3 cursor-pointer${isOut ? ' pt-out-visual' : ''}">
                            ${getProductVisualHTML(product)}
                        </div>

                        <div class="flex items-center justify-between text-[10.5px] sm:text-xs mt-1">
                            <span class="font-bold uppercase tracking-wider text-sage-600 truncate">${escapeHtmlAttr(product.brand)}</span>
                            <span class="inline-flex items-center gap-0.5 text-slate-600 font-semibold shrink-0">
                                <span class="text-amber-400">★</span> ${(product.rating || 4.9).toFixed(1)}
                            </span>
                        </div>

                        <h3 onclick="openQuickView(${product.id})" class="font-display font-bold text-xs sm:text-base text-slate-900 mt-1 line-clamp-2 group-hover:text-sage-700 transition cursor-pointer min-h-[34px] sm:min-h-[48px]">
                            ${escapeHtmlAttr(product.name)}
                        </h3>

                        <div class="flex items-center justify-between mt-1.5 sm:mt-2">
                            <p class="text-[10.5px] sm:text-xs text-slate-500 line-clamp-1">${escapeHtmlAttr(product.category)}</p>
                            ${stockHTML}
                        </div>
                    </div>

                    <div class="pt-2.5 sm:pt-4 mt-2.5 sm:mt-3.5 border-t border-slate-100 space-y-2">
                        <div class="flex items-center justify-between gap-1.5">
                            <div class="leading-tight">
                                <span class="font-display font-extrabold text-sm sm:text-lg text-sage-900">${product.price} DH</span>
                                ${oldPriceHTML}
                            </div>

                            ${addButtonHTML}
                        </div>

                        <button onclick="orderSingleProductOnWhatsApp(${product.id})" class="w-full py-1.5 sm:py-2 px-2 sm:px-3 rounded-full bg-[#F0FDF4] hover:bg-[#25D366] text-[#166534] hover:text-white border border-[#25D366]/40 text-[10.5px] sm:text-xs font-bold transition flex items-center justify-center gap-1 cursor-pointer">
                            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/></svg>
                            <span class="truncate">${isOut ? 'Demander dispo WhatsApp' : 'Commander WhatsApp'}</span>
                        </button>
                    </div>
                </article>
                `;
            }).join('');

            if (paginationEl) {
                paginationEl.innerHTML = buildMinimalCirclePaginationHTML(state.currentPage, totalPages, 'goToCatalogPage');
            }
        }

        function buildMinimalCirclePaginationHTML(currentPage, totalPages, fnName) {
            if (totalPages < 1) return '';

            const pages = [];
            if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else if (currentPage <= 3) {
                pages.push(1, 2, 3, '...', totalPages);
            } else if (currentPage >= totalPages - 2) {
                pages.push(1, '...', totalPages - 2, totalPages - 1, totalPages);
            } else {
                pages.push(1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages);
            }

            const prevDisabled = currentPage <= 1;
            const nextDisabled = currentPage >= totalPages;

            const prevBtn = `
                <button onclick="${fnName}(${currentPage - 1})" ${prevDisabled ? 'disabled' : ''} aria-label="Page précédente" class="w-10 h-10 flex items-center justify-center rounded-full text-slate-900 hover:bg-slate-100 disabled:opacity-30 disabled:pointer-events-none transition cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </button>
            `;

            const nextBtn = `
                <button onclick="${fnName}(${currentPage + 1})" ${nextDisabled ? 'disabled' : ''} aria-label="Page suivante" class="w-10 h-10 flex items-center justify-center rounded-full text-slate-900 hover:bg-slate-100 disabled:opacity-30 disabled:pointer-events-none transition cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            `;

            const itemsHTML = pages.map(p => {
                if (p === '...') {
                    return `<span class="px-1.5 text-slate-800 font-bold tracking-widest select-none">…</span>`;
                }
                const isActive = p === currentPage;
                if (isActive) {
                    return `<button onclick="${fnName}(${p})" aria-current="page" class="w-11 h-11 rounded-full border-2 border-[#34C77B] text-slate-950 font-display font-bold text-base flex items-center justify-center bg-white shadow-2xs transition cursor-pointer">${p}</button>`;
                }
                return `<button onclick="${fnName}(${p})" class="w-10 h-10 rounded-full text-slate-900 hover:bg-slate-100 font-display font-semibold text-base flex items-center justify-center transition cursor-pointer">${p}</button>`;
            }).join('');

            return `
                <nav aria-label="Pagination" class="inline-flex items-center gap-1.5 sm:gap-2.5 py-2">
                    ${prevBtn}
                    ${itemsHTML}
                    ${nextBtn}
                </nav>
            `;
        }

        function changeCatalogItemsPerPage(val) {
            state.itemsPerPage = Math.max(1, Number(val) || 20);
            state.currentPage = 1;
            renderProducts();
        }

        function goToCatalogPage(page) {
            state.currentPage = page;
            renderProducts();
            const catEl = document.getElementById('catalogue');
            if (catEl) catEl.scrollIntoView({ behavior: 'smooth' });
        }

        // FILTRES, RECHERCHE & FAVORIS
        function selectRayon(cat, shouldScroll = true) {
            state.category = cat;
            state.search = '';
            ['searchInput', 'mobileSearchInput'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
            const _clr = document.getElementById('clearSearchBtn'); if (_clr) _clr.classList.add('hidden');
            ptCloseDropdowns();
            state.concernFilter = null;
            state.budget99Only = false;
            state.currentPage = 1;
            document.getElementById('budget99Btn').classList.remove('bg-sage-100', 'border-sage-600', 'text-sage-900', 'font-semibold');
            renderProducts();
            if (shouldScroll) document.getElementById('catalogue').scrollIntoView({ behavior: 'smooth' });
        }

        function filterByBrand(brand) {
            state.brand = brand;
            state.concernFilter = null;
            state.currentPage = 1;
            renderProducts();
            document.getElementById('catalogue').scrollIntoView({ behavior: 'smooth' });
        }

        function togglePromoFilter() {
            state.promoOnly = !state.promoOnly;
            state.currentPage = 1;
            const btn = document.getElementById('promoOnlyBtn');
            btn.classList.toggle('bg-coral-50', state.promoOnly);
            btn.classList.toggle('border-coral-500', state.promoOnly);
            btn.classList.toggle('text-coral-600', state.promoOnly);
            btn.classList.toggle('font-semibold', state.promoOnly);
            renderProducts();
        }

        function toggleBudget99Filter() {
            state.budget99Only = !state.budget99Only;
            state.currentPage = 1;
