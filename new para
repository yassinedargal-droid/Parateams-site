        function parsePriceNumber(val) {
            if (typeof val === 'number') return Math.round(val);
            if (!val) return 0;
            const cleaned = String(val).replace(/[^\d.,]/g, '').replace(',', '.');
            const num = parseFloat(cleaned);
            return isNaN(num) ? 0 : Math.round(num);
        }

