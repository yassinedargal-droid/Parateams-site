                document.getElementById('cmsLoginScreen').classList.add('hidden');
                document.getElementById('cmsDashboardScreen').classList.remove('hidden');
                refreshAllCmsPanels();
                updateCmsHistoryButtons();
            } else {
                document.getElementById('cmsLoginScreen').classList.remove('hidden');
                document.getElementById('cmsDashboardScreen').classList.add('hidden');
