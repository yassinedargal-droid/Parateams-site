        function generateOrderId() {
            const d = new Date();
            const p = n => String(n).padStart(2, '0');
            return `CMD-${String(d.getFullYear()).slice(2)}${p(d.getMonth() + 1)}${p(d.getDate())}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`;
        }
        function recordOrder({ customer, phone, address, source }) {
            const s = SITE_DATA.settings;
            const isCasa = state.selectedCity === 'Casablanca';
            const threshold = isCasa ? Number(s.casaThreshold) : Number(s.otherThreshold);
            const fee = isCasa ? Number(s.casaFee) : Number(s.otherFee);
            const subtotal = state.cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const shipping = subtotal >= threshold ? 0 : fee;
            const order = {
                id: generateOrderId(),
                date: new Date().toISOString(),
                status: 'Nouvelle',
                source: source || 'Site',
                customer: customer || '',
                phone: phone || '',
                address: address || '',
                city: state.selectedCity,
                items: state.cart.map(i => ({ id: i.id, brand: i.brand, name: i.name, price: i.price, qty: i.qty })),
                subtotal, shipping, total: subtotal + shipping
            };
            const list = loadOrders();
            list.unshift(order);
            saveOrders(list);
            return order;
        }
        function buildOrderMessage(o) {
            const s = SITE_DATA.settings;
            const lines = o.items.map(i => `• ${i.qty}x ${i.brand} ${i.name} = ${i.price * i.qty} DH`).join('\n');
            return `Bonjour ${s.brandName} 👋,\nJe viens de passer la commande ${o.id} :\n\n${lines}\n\n• Nom : ${o.customer}\n• Téléphone : ${o.phone}\n• Adresse : ${o.address} (${o.city})\n• Livraison : ${o.shipping === 0 ? 'Offerte' : o.shipping + ' DH'}\n• Total à régler : ${o.total} DH`;
