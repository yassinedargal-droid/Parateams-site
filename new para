                <rect x="74" y="64" width="6" height="135" rx="3" fill="#0095D9"/>
                <rect x="88" y="94" width="44" height="10" rx="2" fill="#5D9C2A" fill-opacity="0.75"/>
                <rect x="82" y="236" width="56" height="42" rx="6" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="1.2"/>
