        function clearBulkStaging() {
            bulkStagedProducts = [];
            document.getElementById('bulkStagingBox').classList.add('hidden');
        }

        function commitBulkStagedProducts() {
            const selected = bulkStagedProducts.filter(p => p.selected && p.name && p.price > 0);
            if (selected.length === 0) {
                showToast("Sélectionnez au moins un produit valide à importer.");
                return;
            }

            pushCmsUndoSnapshot();
            const mode = document.getElementById('bulkImportModeSelect').value;
            let nextId = mode === 'replace' ? 1 : (Math.max(0, ...SITE_DATA.products.map(p => p.id)) + 1);

            const newProducts = selected.map(item => syncProductStockFields({
                id: nextId++,
                brand: item.brand || "Parateams",
                name: item.name,
                category: normalizeCategoryName(item.category),
                concern: "Hydratation",
                skinType: "Tous types",
                benefit: item.badge || "Soin dermo-cosmétique",
                price: Number(item.price),
                oldPrice: item.oldPrice ? Number(item.oldPrice) : null,
                badge: item.badge || (item.oldPrice ? "Promo" : "Nouveau"),
                badgeType: item.oldPrice ? "promo" : "new",
                isNew: true,
                rating: 4.9,
                reviewsCount: 14,
                volume: "",
                color: "#5D9C2A",
                shape: "bottle",
                imageUrl: item.imageUrl || "",
                description: item.description || `${item.brand} — ${item.name}`,
                usage: "Appliquer selon les recommandations de votre pharmacien Parateams.",
                ingredients: ""
            }, item.stockQty ?? getDefaultInitialStock()));

            if (mode === 'replace') {
                SITE_DATA.products = newProducts;
            } else {
                const existingNames = new Set(SITE_DATA.products.map(x => x.name.toLowerCase()));
                const uniqueNew = newProducts.filter(x => !existingNames.has(x.name.toLowerCase()));
                SITE_DATA.products = [...uniqueNew, ...SITE_DATA.products];
            }

            clearBulkStaging();
            saveCmsToLocalPreview(true);
            switchCmsTab('products');
            showToast(`🎉 ${newProducts.length} produit(s) importés ! Vous pouvez ajuster vos quantités.`);
