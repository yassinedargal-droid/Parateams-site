      const src = img.getAttribute('data-src') || img.getAttribute('data-lazy-src') || img.currentSrc || img.src || '';
      if (!src || /logo|icon|avatar|flag|payment/i.test(src)) return;
      let card = img.parentElement;
      let found = null;
      for (let d = 0; d < 6 && card && card.tagName !== 'BODY'; d++) {
        const t = card.innerText || '';
        if (/(\\d+(?:[.,]\\d+)?)\\s*(?:MAD|DH|Dhs)/i.test(t) && card.querySelectorAll('img').length <= 3) {
          found = card; break;
        }
        card = card.parentElement;
      }
      if (!found) return;
      const text = found.innerText || '';
      const prices = [...text.matchAll(/(\\d+(?:[.,]\\d+)?)\\s*(?:MAD|DH|Dhs)/gi)]
        .map(m => parseFloat(m[1].replace(',', '.')))
        .filter(n => !isNaN(n) && n > 5);
      if (prices.length === 0) return;
      const lines = text.split(/\\r?\\n/)
        .map(l => l.replace(/\\s+/g, ' ').trim())
        .filter(l => l.length > 2 && !/^(rupture de stock|épuisé|epuise|ajouter|aperçu|favoris|\\d+(?:[.,]\\d+)?\\s*(?:mad|dh|dhs)|★+|\\d+[.,]\\d+\\s*\\(\\d+\\))$/i.test(l));
      let brand = '', name = '';
      if (lines.length >= 2 && lines[0].length <= 28 && lines[1].length > lines[0].length) {
        brand = lines[0]; name = lines[1];
      } else if (lines.length >= 1) {
