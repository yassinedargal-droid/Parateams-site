                    <td class="p-2.5">
                        <div class="w-10 h-10 rounded-lg bg-sage-50 border border-slate-200 flex items-center justify-center overflow-hidden p-0.5">
                            ${item.imageUrl ? `<img onerror="handleImgError(this)" src="${escapeHtmlAttr(item.imageUrl)}" class="max-h-full max-w-full object-contain">` : '<span class="text-[10px] text-slate-400">Auto</span>'}
                        </div>
                    </td>
