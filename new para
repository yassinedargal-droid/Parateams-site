      const json = JSON.stringify(finalItems, null, 2);
      const ta = document.createElement('textarea');
      ta.value = json; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      copyBtn.textContent = '✅ ' + finalItems.length + ' PRODUITS COPIÉS !';
      copyBtn.style.background = '#2563eb';
    };

    const resetBtn = document.createElement('button');
    resetBtn.textContent = '🗑️ 0';
    resetBtn.title = 'Remettre le compteur à zéro';
    resetBtn.style.cssText = 'padding:10px 12px;background:#334155;color:#fff;font-weight:bold;border:none;border-radius:10px;cursor:pointer;font-size:12px;';
    resetBtn.onclick = () => {
      window.__PARATEAMS_BAG.clear();
      localStorage.removeItem(STORAGE_KEY);
      scanPage();
      renderBar();
    };

    bar.appendChild(autoAllBtn);
    bar.appendChild(copyBtn);
    bar.appendChild(resetBtn);
  };

  renderBar();
})();`;
            copyTextWithFallback(snippet, "📋 Script Auto-Pagination copié ! Collez-le dans la Console de Palmarosa Shop.");
        }

        function insertExtractedItemsDirectlyIntoTable(rawContent) {
            const items = parseProductsFromHtmlOrJson(rawContent);
            if (!items || items.length === 0) return 0;

            const initialStockEl = document.getElementById('quickPasteInitialStock');
            const initialStock = initialStockEl ? Math.max(0, Math.floor(Number(initialStockEl.value) || 0)) : 0;

            pushCmsUndoSnapshot();
            let nextId = Math.max(0, ...SITE_DATA.products.map(p => p.id)) + 1;
            const existingNames = new Set(SITE_DATA.products.map(p => p.name.toLowerCase()));
            const newProducts = [];

            items.forEach(item => {
                if (existingNames.has(item.name.toLowerCase())) return;
                existingNames.add(item.name.toLowerCase());
                newProducts.push(syncProductStockFields({
                    id: nextId++,
                    brand: item.brand || "Parateams",
                    name: item.name,
                    category: normalizeCategoryName(item.category),
                    concern: "Hydratation",
                    skinType: "Tous types",
                    benefit: item.badge || "Soin dermo-cosmétique",
                    price: Number(item.price) || 120,
                    oldPrice: item.oldPrice ? Number(item.oldPrice) : null,
                    badge: item.badge || (item.oldPrice ? "Promo" : "Nouveau"),
                    badgeType: item.oldPrice ? "promo" : "new",
                    isNew: true,
                    rating: 4.9,
                    reviewsCount: 14,
                    volume: "",
                    color: "#5D9C2A",
                    shape: "bottle",
                    imageUrl: item.imageUrl || "",
                    description: item.description || `${item.brand} — ${item.name}`,
                    usage: "Appliquer selon les recommandations de votre pharmacien Parateams.",
                    ingredients: ""
                }, initialStock));
            });

            if (newProducts.length > 0) {
                SITE_DATA.products = [...newProducts, ...SITE_DATA.products];
                cmsProductsCurrentPage = 1;
                cmsProductsViewMode = 'table';
                saveCmsToLocalPreview(true);
                showToast(`🎉 ${newProducts.length} nouveaux produits ajoutés dans le tableau !`);
            } else {
                showToast(`Tous ces produits (${items.length}) figurent déjà dans votre tableau.`);
            }
            return newProducts.length;
        }

        function exportInventoryTableToCsv() {
            const headers = "id;brand;name;category;price;oldPrice;stockQty;imageUrl";
            const rows = SITE_DATA.products.map(p =>
                `${p.id};"${(p.brand || '').replace(/"/g, '""')}";"${(p.name || '').replace(/"/g, '""')}";"${p.category}";${p.price};${p.oldPrice || ''};${getProductStockQty(p)};"${p.imageUrl || ''}"`
            );
            const csv = "\uFEFF" + [headers, ...rows].join("\n");
            const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `inventaire-parateams-${new Date().toISOString().slice(0, 10)}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("📥 Tableau d'inventaire exporté en CSV (Excel) !");
        }

