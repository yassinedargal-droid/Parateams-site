                clearTimeout(timer);
                timer = setTimeout(() => ptRenderDropdown(input, dd), 80);
            });
            input.addEventListener('focus', () => { if (input.value.trim()) ptRenderDropdown(input, dd); });
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); submitSearch(input.value); }
                else if (e.key === 'Escape') { ptCloseDropdowns(); }
            });
