        function updateHeroSliderUI() {
            const slides = document.querySelectorAll('.hero-slide');
            const dots = document.querySelectorAll('.hero-dot');
            slides.forEach((slide, idx) => {
                slide.classList.toggle('opacity-100', idx === currentHeroSlide);
                slide.classList.toggle('z-10', idx === currentHeroSlide);
                slide.classList.toggle('opacity-0', idx !== currentHeroSlide);
                slide.classList.toggle('pointer-events-none', idx !== currentHeroSlide);
                slide.classList.toggle('z-0', idx !== currentHeroSlide);
            });
            dots.forEach((dot, idx) => {
                dot.classList.toggle('active', idx === currentHeroSlide);
                dot.classList.toggle('w-9', idx === currentHeroSlide);
                dot.classList.toggle('sm:w-10', idx === currentHeroSlide);
                dot.classList.toggle('bg-white', idx === currentHeroSlide);
                dot.classList.toggle('w-3', idx !== currentHeroSlide);
                dot.classList.toggle('bg-white/35', idx !== currentHeroSlide);
            });
        }

        function nextHeroSlide() {
            const total = SITE_DATA.slides.length || 1;
            currentHeroSlide = (currentHeroSlide + 1) % total;
            updateHeroSliderUI();
        }

        function prevHeroSlide() {
            const total = SITE_DATA.slides.length || 1;
            currentHeroSlide = (currentHeroSlide - 1 + total) % total;
            updateHeroSliderUI();
        }

        function goToHeroSlide(index) {
            currentHeroSlide = index;
            updateHeroSliderUI();
            startHeroAutoPlay();
        }

        function startHeroAutoPlay() {
            if (heroAutoPlayTimer) clearInterval(heroAutoPlayTimer);
            heroAutoPlayTimer = setInterval(nextHeroSlide, 5500);
        }

        function initHeroSliderInteractions() {
            const sliderContainer = document.getElementById('heroSliderContainer');
            if (!sliderContainer) return;
            startHeroAutoPlay();
            let touchStartX = 0;
            sliderContainer.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
            sliderContainer.addEventListener('touchend', (e) => {
                const diff = touchStartX - e.changedTouches[0].screenX;
                if (Math.abs(diff) > 45) diff > 0 ? nextHeroSlide() : prevHeroSlide();
            }, { passive: true });
        }

